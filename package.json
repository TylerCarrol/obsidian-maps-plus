{
	"name": "maps-plus",
	"version": "0.1.0",
	"description": "Maps+ plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "npm run generate:rtl-plugin && node esbuild.config.mjs",
		"build": "npm run generate:rtl-plugin && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:demo-vault": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-to-demo-vault.ps1",
		"generate:countries": "node scripts/generate-countries.mjs",
		"generate:countries:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-countries-and-areas-debug.ps1",
		"generate:areas": "node scripts/generate-areas.mjs",
		"generate:tdsb-school-catchments": "node scripts/generate-tdsb-school-catchments.mjs",
		"generate:subway-walksheds": "node scripts/generate-subway-walksheds.mjs",
		"generate:rtl-plugin": "node scripts/generate-rtl-plugin.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.0.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	},
	"dependencies": {
		"@mapbox/mapbox-gl-rtl-text": "^0.4.0",
		"maplibre-gl": "^5.24.0",
		"polygon-clipping": "^0.15.7"
	}
}
